#danmaku-list-scroll-container
	{
		display: block;
        width: 100%;
		height: 90%;
		overflow-y: scroll;
		margin-top: -20dp;
	}
	scrollbarvertical
	{
		width: 27px;
	}

       #danmaku-list
       {
           display: block;
           width: 100%;
           height: auto;
       }

	.danmaku-item-appear-anim-container
	{
		display: block;
		height: auto;
		overflow-y: hidden;
		transition: transform 1s elastic-out;
		transform: scale(.65, .8);
	}

	.danmaku-item-appear-anim-container.show
	{
        transform: scale(1, 1);
	}

	danmaku-item
	{
		display: block;
		height: auto;

	}

       .danmaku-item
       {
           display: block;
           padding: 4dp 8dp;
           margin-bottom: 2dp;
       }


       .danmaku-item:hover
       {
           background-color: rgb(52, 52, 52);
       }

       #sender
       {
           display: inline-block;
           font-weight: bold;
           color: rgb(150, 200, 255);
           margin-right: 8dp;
       }

       #content
       {
		display: inline;
           color: rgb(220, 220, 220);
       }

     #time
     {
         display: block;
		height: 1em;
         color: rgb(150, 150, 150);
         font-size: 14dp;
     }

	/* 自动滚动开关（通用 toggle 元素，外观见 main.rcss）在弹幕窗口中的定位：
	 * 悬浮于右下角，盖在弹幕列表之上。 */
	#auto-scroll-toggle
	{
		position: absolute;
		right: 8dp;
		bottom: 6dp;
		z-index: 200;
	}


