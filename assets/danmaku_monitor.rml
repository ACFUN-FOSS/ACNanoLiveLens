<rml>
<head>
    <title>Danmaku Monitor</title>
    <link type="text/rcss" href="main.rcss"/>
    <style>
        #danmaku-list
        {
            display: block;
            width: 100%;
            height: 100%;
            overflow-y: hidden;
            overflow-x: hidden;
        }

        .danmaku-item
        {
            display: block;
            padding: 4dp 8dp;
            margin-bottom: 2dp;
            background-color: rgba(60, 60, 60, 0.8);
            border-radius: 4dp;
            border-left: 3dp solid rgb(100, 150, 200);
        }

        .danmaku-item:hover
        {
            background-color: rgba(80, 80, 80, 0.9);
        }

        .danmaku-sender
        {
            display: inline-block;
            font-weight: bold;
            color: rgb(150, 200, 255);
            margin-right: 8dp;
        }

        .danmaku-content
        {
            display: inline-block;
            color: rgb(220, 220, 220);
        }

        .danmaku-time
        {
            display: inline-block;
            float: right;
            color: rgb(150, 150, 150);
            font-size: 14dp;
        }
    </style>
</head>
<body>
    <winframe id="winframe">
        <div class="content" id="content">
            <h1>Danmaku Monitor</h1>
			<button id="add-danmaku-btn" class="test-btn">Add danmaku</button>
            <div id="danmaku-list"></div>
        </div>
    </winframe>
</body>
</rml>
