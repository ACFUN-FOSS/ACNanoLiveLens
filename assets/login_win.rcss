.login-content
{
    display: block;
    height: 100%;
    margin: 0 auto;
}

.login-hint-container
{
	display: flex;
    justify-content: center;
    align-items: center;
}

.qr-code-container
{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 300dp;
    margin: 0 0 5dp 0;
}

.qr-code-placeholder
{
    color: #666666;
    font-size: 18dp;
}

.qr-code
{
    width: 250dp;
    height: 250dp;
    display: none;
}

.refresh-btn
{
    display: block;
    width: 120dp;
    height: 22dp;
    margin: 0 auto;
	padding: 3dp 0;
    background-color: rgb(76, 120, 210);
    border-radius: 6dp;
    text-align: center;
    font-size: 16dp;
    color: white;
}
