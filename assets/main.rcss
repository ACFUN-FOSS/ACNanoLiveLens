body
{
    font-family: "Nokia Sans";
	font-size: 17dp;
	width: 100vw;
    height: 100vh;
}

.test-btn
{
	display: block;
	background-color: red;
	width: 30dp;
	height: 18dp;
	padding: 2dp 5dp;
	border-radius: 6dp;
	z-order: 100;
}

button
{
	display: block;
	height: 24dp;
	width: 300dp;
	margin: 0 auto;
	padding: 3dp 0;
	border-radius: 16dp;
	text-align: center;
    font-size: 16dp;
	background-color: red;
	color: white;
}

winframe
{
    display: block;
	border-radius: 8dp;
	border: 1px rgba(100, 100, 100, 100);
	background-color: rgb(42, 42, 42);
	width: 100%;
	height: 100%;
	z-index: -1;
}

winframe.closing
{
	border: 1px rgb(180, 140, 80);
	background-color: rgb(56, 48, 38);
}

.winframe-internal-content
{
    display: block;
    width: 100%;
}
.winframe-internal-content .title-bar
{
    display: block;
    border-radius: 8dp 8dp 0 0;
    background-color: rgb(80, 80, 80);

    width: 100%;
    height: 23dp;

}

winframe.closing .winframe-internal-content .title-bar
{
    background-color: rgb(140, 100, 55);
}

.winframe-internal-content .title-bar .title-text
{
    display: inline-block;
    padding: 1dp 0 0 10dp;
}

.winframe-internal-content .title-bar-btns
{
    float: right;
    width: 35dp;
}

.winframe-internal-content .title-bar-btn
{
    display: inline-block;
    width: 20dp;
    height: 20dp;
    margin: 2dp 0 0 4dp;
}

winframe .content
{
	display: block;
	width: auto;
	height: 100%;
	padding: 2dp 4dp 2dp 4dp;
}

#not-live-hint
{
	display: block;
	width: 100%;
	height: 100%;
	text-align: center;
	padding-top: 120dp;
	color: rgb(190, 190, 190);
}

svg
{
    display: inline-block;
    width: 100%;
    height: 100%;
}


h1
{
    margin: 0 0 8dp 0;
    font-size: 20dp;
}

p
{
    margin: 0;
    line-height: 1.4;
}

/* 通用滑块/开关（自绘自定义元素 Toggle，见 src/toggle.cxx）：
 * 仅定义外观（尺寸/圆角/配色/过渡）；定位与层叠由使用方在自己的
 * 样式表中指定（见 danmaku.rcss 的 #auto-scroll-toggle）。
 * 元素自身即滑轨，.on 表示开启（红色滑轨 + 滑块右移）。 */
toggle
{
    display: block;
    width: 34dp;
    height: 18dp;
    border-radius: 9dp;
    background-color: rgb(85, 85, 85);
    transition: background-color 0.15s;
}

toggle.on
{
    background-color: rgb(220, 60, 60);
}

toggle .knob
{
    display: block;
    width: 14dp;
    height: 14dp;
    margin: 2dp;
    border-radius: 7dp;
    background-color: rgb(235, 235, 235);
    transform: translateX(0dp);
    transition: transform 0.15s;
}

toggle.on .knob
{
    transform: translateX(16dp);
}

