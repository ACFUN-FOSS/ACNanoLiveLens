.msg-box-content
{
    display: block;
    height: 100%;
}

.msg-box
{
    display: block;
    width: 100%;
    height: 100%;
    padding: 8dp 6dp 10dp 6dp;
}

.msg-box-title
{
	display: block;
    margin: 0 0 4dp 0;
    font-size: 22dp;
    font-weight: bold;
}

.msg-box-text
{
    display: block;
    width: 100%;
    height: 130dp;
    margin: 0 0 12dp 0;
    line-height: 1.35;
    white-space: pre-wrap;
}


.msg-box-error .msg-box-title
{
    color: rgb(255, 110, 110);
}

.msg-box-warning .msg-box-title
{
    color: rgb(255, 215, 110);
}

.msg-box-info .msg-box-title
{
    color: rgb(120, 200, 255);
}
