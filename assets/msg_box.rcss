.msg-box
{
    display: block;
    height: 100%;
	padding: 5dp 8dp;
}

.msg-box-title
{
	display: block;
    font-size: 22dp;
	line-height: 1.5;
    font-weight: bold;
}

.msg-box-text
{
    display: block;
    width: 100%;
    height: 130dp;
    line-height: 1.35;
    white-space: pre-wrap;
	word-break: break-all;
}


.msg-box-error .msg-box-title
{
    color: rgb(255, 110, 110);
}

.msg-box-warning .msg-box-title
{
    color: rgb(255, 215, 110);
}

.msg-box-info .msg-box-title
{
    color: rgb(120, 200, 255);
}
