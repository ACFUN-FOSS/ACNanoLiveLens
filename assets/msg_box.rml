<rml>
<head>
    <title>Message Box</title>
    <link type="text/rcss" href="main.rcss"/>
    <link type="text/rcss" href="msg_box.rcss"/>
</head>
<body>
    <winframe id="winframe">
        <div class="content">
			<div class="msg-box" id="msg-box">
				<div class="msg-box-title" id="msg-box-title"></div>
				<div class="msg-box-text" id="msg-box-text"></div>
				<button id="ok-btn">OK</button>
			</div>
        </div>
    </winframe>
</body>
</rml>
